{
  "name": "my-app",
  "version": "0.1.0",
  "private": true,
  "description": "A Queek installable app: install/uninstall/settings/webhooks over the app SDK.",
  "type": "module",
  "scripts": {
    "dev": "queek app dev",
    "deploy": "queek app deploy",
    "build": "tsc -p tsconfig.json && vite build --config admin-ui/vite.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:admin": "tsc --noEmit -p admin-ui/tsconfig.json",
    "build:admin": "vite build --config admin-ui/vite.config.ts",
    "test": "vitest run",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@usequeek/app-sdk": "^0.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "4.13.9",
    "lucide-react": "^0.479.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router": "^7.18.4",
    "smol-toml": "^1.4.2",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vite": "^7.3.6",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": "22"
  }
}
