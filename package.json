{
  "name": "my-app",
  "version": "0.1.0",
  "private": true,
  "description": "A Queek installable app: install/uninstall/settings/webhooks over the app SDK.",
  "type": "module",
  "scripts": {
    "dev": "queek app dev",
    "deploy": "queek app deploy",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@usequeek/app-sdk": "^0.4.0",
    "hono": "4.13.9"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "22.20.4",
    "smol-toml": "^1.4.2",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": "22"
  }
}
