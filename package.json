{
  "name": "my-app",
  "version": "0.1.0",
  "private": true,
  "description": "A Queek installable app: a React Router app (server loaders + actions) over the Queek app SDK.",
  "type": "module",
  "scripts": {
    "dev": "queek app dev",
    "dev:server": "node ./server.js",
    "codegen": "queek app codegen",
    "deploy": "queek app deploy",
    "build": "react-router build",
    "start": "node ./server.js",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "node scripts/check-public-text.mjs && node --test scripts/check-public-text.test.mjs && vitest run"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@react-router/express": "7.18.4",
    "@react-router/node": "7.18.4",
    "@usequeek/app-sdk": "^0.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express": "^4.22.3",
    "isbot": "^5.1.31",
    "lucide-react": "^1.49.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router": "7.18.4",
    "smol-toml": "^1.4.2",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@react-router/dev": "7.18.4",
    "@react-router/fs-routes": "7.18.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "vite": "^7.3.6",
    "vite-tsconfig-paths": "^6.0.4",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22.14"
  }
}
