# Copy to .env (never commit .env). Every value here is server-side only.
# Public base URL of THIS app. Must match the URLs in queek.app.toml —
# `queek app deploy` pushes that file, so change the toml first, then this.
APP_BASE_URL=https://my-app.apps.queek.com.ng
PORT=3000
# The app signing secret (whsec_…), printed ONCE by `queek app deploy` on first
# registration (also written to .queek/.env.local). Verifies the
# install/uninstall/settings handoff signatures.
QUEEK_APP_SECRET=whsec_change_me
# 32 random bytes, base64 or hex. Encrypts installation api_key + webhook_secret at rest.
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=change_me_to_32_random_bytes_base64
# SQLite file holding INSTALLATIONS ONLY (WAL mode). Mount a volume here on Dokploy.
QUEEK_DB_PATH=./data/my-app.db
